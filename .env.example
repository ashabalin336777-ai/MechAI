# Шаблон переменных окружения (раздел 15 ТЗ). Скопировать в .env и заполнить локально.
# .env не коммитится. На App Platform значения задаются в панели как секреты.
# Здесь только имена; секреты пустые.

# Neuraldeep (модели в РФ)
NEURALDEEP_API_KEY=
NEURALDEEP_BASE_URL=https://api.neuraldeep.ru/v1
AGENT_MODEL=qwen3.8-flash-next-ru-noreason
AGENT_FALLBACK_MODEL=qwen3.8-flash-next-ru-noreason
EMBED_MODEL=bge-m3
RERANK_MODEL=bge-reranker
OCR_MODEL=gemma-4-31b-noreason
OCR_FALLBACK_MODEL=qwen3.6-35b-a3b-noreason
STT_MODEL=whisper-1
STT_BROWSER_FALLBACK=0

# Заглушки заказчика и датчики. Для запуска вне compose: http://127.0.0.1:8001 и http://127.0.0.1:8002
MOCK_ML_URL=http://mock_ml:8001
MOCK_TOIR_URL=http://mock_toir:8002
SENSORS_URL=
MOUNT_MOCKS=0

# Данные
DATABASE_URL=
VEHICLES_PATH=mock/data/vehicles.json
FAULT_TYPES_PATH=mock/data/fault_types.json
MANUALS_DIR=data/manuals

# Материалы задачи вне git (п. 9.1 требований организатора). Публичная ссылка на папку с файлами.
# MATERIALS_URL — общая папка (vehicles.json, fault_types.json, PDF). MANUALS_URL и MOCK_DATA_URL
# переопределяют её для PDF и для JSON заглушек. Пусто — файлы не докачиваются, /health покажет materials: missing.
MATERIALS_URL=
MANUALS_URL=
MOCK_DATA_URL=
# Архив с заглушками в той же папке: из него берутся vehicles.json и fault_types.json, если отдельных файлов нет
MOCK_ARCHIVE_NAME=neurodvs_hackathon_mock_2026-11-16.zip

# Пороги агента (раздел 7 ТЗ)
CONF_LOW=0.60
SCORE_MEDIUM=0.60
SCORE_HIGH=0.80
RAG_MIN_SCORE=0.80

# Лимиты хода агента
AGENT_TIMEOUT_S=90
AGENT_MAX_TOOL_CALLS=8

# Доступ и хранение
AUTH_MODE=demo
JWT_SECRET=
LOG_RETENTION_DAYS=90

# Админ-доступ к POST /admin/eval (Bearer). Пусто — эндпоинта нет. Задавать как секрет в панели.
ADMIN_TOKEN=
# Хэш коммита для записи в eval_runs. Пусто — в таблице NULL.
COMMIT_SHA=

# Локальный запуск с docker-compose.local.yml (только в локальном .env)
POSTGRES_PASSWORD=
