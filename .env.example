# Шаблон переменных окружения (раздел 15 ТЗ). Скопировать в .env и заполнить локально.
# .env не коммитится. На App Platform значения задаются в панели как секреты.
# Здесь только имена; секреты пустые.

# Neuraldeep (модели в РФ)
NEURALDEEP_API_KEY=
NEURALDEEP_BASE_URL=https://api.neuraldeep.ru/v1
AGENT_MODEL=qwen3.8-flash-next-ru-noreason
AGENT_FALLBACK_MODEL=qwen3.8-flash-next-ru-noreason
EMBED_MODEL=bge-m3
RERANK_MODEL=bge-reranker
STT_MODEL=whisper-1
STT_BROWSER_FALLBACK=0

# Заглушки заказчика и датчики. Для запуска вне compose: http://127.0.0.1:8001 и http://127.0.0.1:8002
MOCK_ML_URL=http://mock_ml:8001
MOCK_TOIR_URL=http://mock_toir:8002
SENSORS_URL=
MOUNT_MOCKS=0

# Данные
DATABASE_URL=
VEHICLES_PATH=mock/data/vehicles.json
FAULT_TYPES_PATH=mock/data/fault_types.json
MANUALS_DIR=data/manuals
MANUALS_YADISK_URL=https://disk.yandex.ru/d/QdAA8p4m0ySe8Q

# Пороги агента (раздел 7 ТЗ)
CONF_LOW=0.60
SCORE_HIGH=0.80
RAG_MIN_SCORE=0.35

# Доступ и хранение
AUTH_MODE=demo
JWT_SECRET=
LOG_RETENTION_DAYS=90

# Локальный запуск с docker-compose.local.yml (только в локальном .env)
POSTGRES_PASSWORD=
