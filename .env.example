# Шаблон переменных окружения. Скопировать в .env и заполнить локально.
# .env не коммитится. В App Platform значения задаются в панели как секреты.
# Здесь только имена и пустые значения.

# PostgreSQL (DBaaS с pgvector), со SSL
DATABASE_URL=

# Neuraldeep
NEURALDEEP_API_KEY=
NEURALDEEP_BASE_URL=https://api.neuraldeep.ru/v1
FAST_MODEL=qwen3.6-fp8
REASONING_MODEL=qwen3.8-27b
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker

# Timeweb S3
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Сессия
JWT_SECRET=
JWT_TTL_HOURS=12

# Приложение
APP_ENV=dev
LOG_LEVEL=INFO
SEED_ON_START=false

# Демо-учётки для seed (только секреты панели / локальный .env)
ADMIN_TABEL=
ADMIN_PIN=
MECH_TABEL=
MECH_PIN=
