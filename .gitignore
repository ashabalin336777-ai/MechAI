*.backup
dumps/

# Сырой JSON прогона агента (локально; отчёт в eval/reports/)
agent_eval.json
rag_eval.json

# Локальные скрипты и результаты пробы OCR (не коммитим)
ocr_probe.ps1
eval/reports/ocr_*
eval/reports/agent_run_*
