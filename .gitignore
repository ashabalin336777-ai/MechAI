# Секреты и локальные настройки: никогда не коммитить
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Редакторы и ОС
node_modules/
.idea/
.vscode/
Thumbs.db

# материалы задачи не публикуем, требование организатора, п. 9.1
data/manuals/*.pdf
mock/data/
docs/customer/

# Дампы баз и выгрузки (SQL-миграции в app/db/migrations коммитятся)
