{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackathon.local/schemas/engine-diagnostics-ml-v1.1.json",
  "title": "EngineDiagnosticsMLResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis",
    "vehicle",
    "recording",
    "overall",
    "faults",
    "recommended_checks",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_id",
        "analyzed_at",
        "model_id",
        "model_version"
      ],
      "properties": {
        "analysis_id": {
          "type": "string",
          "format": "uuid"
        },
        "analyzed_at": {
          "type": "string",
          "format": "date-time"
        },
        "model_id": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "pipeline": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Шаги обработки, например spectral_features, anomaly_detector, fault_classifier"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "driver_complaint",
            "scheduled_check",
            "mechanic_request",
            "post_repair_check"
          ],
          "description": "Что инициировало запись (v1.1)."
        }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle_id",
        "make",
        "model",
        "year",
        "engine",
        "mileage_km"
      ],
      "properties": {
        "vehicle_id": {
          "type": "string"
        },
        "vin": {
          "type": [
            "string",
            "null"
          ]
        },
        "fleet_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "type": "string",
          "enum": [
            "taxi",
            "lcv",
            "truck",
            "private",
            "corporate"
          ]
        },
        "make": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "generation": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 1980
        },
        "license_plate": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "fuel",
            "displacement_l",
            "cylinders"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "code": {
              "type": "string"
            },
            "family": {
              "type": [
                "string",
                "null"
              ]
            },
            "fuel": {
              "type": "string",
              "enum": [
                "gasoline",
                "diesel",
                "lpg",
                "cng",
                "hybrid"
              ]
            },
            "displacement_l": {
              "type": "number"
            },
            "cylinders": {
              "type": "integer"
            },
            "configuration": {
              "type": "string"
            },
            "rated_power_kw": {
              "type": [
                "number",
                "null"
              ]
            },
            "aspiration": {
              "type": "string",
              "enum": [
                "na",
                "turbo",
                "supercharged"
              ]
            }
          }
        },
        "mileage_km": {
          "type": "integer",
          "minimum": 0
        },
        "operating_hours": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at",
        "duration_s",
        "sample_rate_hz",
        "sensor_type",
        "conditions",
        "quality"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_s": {
          "type": "number",
          "minimum": 1
        },
        "sample_rate_hz": {
          "type": "integer"
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "sensor_type": {
          "type": "string",
          "enum": [
            "smartphone_mic",
            "contact_mic",
            "mic_array",
            "accelerometer",
            "knock_sensor",
            "combined"
          ]
        },
        "sensor_position": {
          "type": "string"
        },
        "audio_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ссылка или id записи; сам файл ML-сервис может не хранить"
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine_speed_rpm",
            "engine_state"
          ],
          "properties": {
            "engine_state": {
              "type": "string",
              "enum": [
                "idle",
                "off_idle",
                "cruise",
                "load",
                "revving"
              ]
            },
            "engine_speed_rpm": {
              "type": "number"
            },
            "engine_load_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "coolant_temp_c": {
              "type": [
                "number",
                "null"
              ]
            },
            "oil_temp_c": {
              "type": [
                "number",
                "null"
              ]
            },
            "vehicle_speed_kph": {
              "type": [
                "number",
                "null"
              ]
            },
            "gear": {
              "type": [
                "string",
                "null"
              ]
            },
            "ambient_temp_c": {
              "type": [
                "number",
                "null"
              ]
            },
            "environment": {
              "type": "string",
              "enum": [
                "workshop",
                "depot",
                "roadside",
                "open_road"
              ]
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "degraded",
                "rejected"
              ]
            },
            "snr_db": {
              "type": [
                "number",
                "null"
              ]
            },
            "rms_dbfs": {
              "type": [
                "number",
                "null"
              ]
            },
            "silence_ratio": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "clipping_ratio": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rerecord_instructions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Как повторить запись, если качество не подошло (v1.1). Критерии см. СР-ISF28-ДЕМО стр. 12-02, 12-07."
            }
          }
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "anomaly_score",
        "severity",
        "confidence",
        "urgency"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "normal",
            "anomaly",
            "uncertain"
          ]
        },
        "anomaly_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Как DCASE/MIMII: нормированный score аномалии, 0=норма, 1=явная аномалия"
        },
        "severity": {
          "type": "string",
          "enum": [
            "normal",
            "attention",
            "warning",
            "critical",
            "undetermined"
          ]
        },
        "severity_zone": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "severity_standard": {
          "type": "string",
          "description": "Для ДВС легковых ISO 10816/20816 неприменимы буквально. Для коммерческого дизеля >100 кВт ориентир — ISO 10816-6. В демо зоны A–D используются как общепринятый язык срочности."
        },
        "urgency": {
          "type": "string",
          "enum": [
            "can_operate",
            "inspect_this_week",
            "inspect_immediately",
            "do_not_operate",
            "recording_invalid"
          ],
          "description": "recording_invalid (v1.1): запись непригодна (quality.status=rejected), зона и срочность не определены; нужна повторная запись. Это НЕ равно can_operate."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overall_vibration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rms_velocity_mm_s": {
              "type": "number"
            },
            "peak_acceleration_g": {
              "type": [
                "number",
                "null"
              ]
            },
            "frequency_range_hz": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "requires_rerecord": {
          "type": "boolean",
          "description": "v1.1: ML-сервис просит повторить запись."
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name_ru",
          "probability",
          "confidence",
          "severity",
          "recommended_checks"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "normal",
              "conrod_bearing_knock",
              "main_bearing_knock",
              "piston_slap",
              "valve_clearance",
              "hydraulic_lifter",
              "timing_chain_stretch",
              "timing_belt_wear",
              "injector_fault",
              "misfire",
              "knock_detonation",
              "turbocharger_fault",
              "accessory_drive",
              "exhaust_leak",
              "fuel_pump"
            ]
          },
          "name_ru": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "component": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bank": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cylinder": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "side": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "frequency_bands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "f_low_hz",
                "f_high_hz"
              ],
              "properties": {
                "f_low_hz": {
                  "type": "number"
                },
                "f_high_hz": {
                  "type": "number"
                },
                "peak_hz": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "amplitude": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "mm/s",
                    "g",
                    "dB"
                  ]
                },
                "shaft_order": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Кратность оборотам коленвала (1.0 = частота вращения)"
                }
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "normal",
              "attention",
              "warning",
              "critical",
              "undetermined"
            ]
          },
          "severity_zone": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "related_dtcs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended_checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "obd": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "mil_on": {
          "type": "boolean"
        },
        "dtcs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "status",
              "description"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[PBCU][0-9A-F]{4}$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "pending",
                  "permanent",
                  "history"
                ]
              },
              "system": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "pids": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "unit"
            ],
            "properties": {
              "pid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "recommended_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Что проверить в первую очередь; агент ищет процедуры в мануале по этим формулировкам"
    },
    "service_hints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Короткие подсказки для разговора механика, в духе Pro-Stuk"
    },
    "disclaimer": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "description": "Служебные метаданные заглушки (v1.1). Реальный ML-сервис может их не отдавать.",
      "properties": {
        "synthetic": {
          "type": "boolean"
        },
        "scenario_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
